{
  "expo": {
    "name": "eDawr Delivery",
    "slug": "edawr-delivery",
    "scheme": "edawr-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "primaryColor": "#6d28d9",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edawr.delivery",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "eDawr Rider",
        "LSApplicationQueriesSchemes": [
          "tel"
        ]
      }
    },
    "android": {
      "package": "com.edawr.delivery",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e1065"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2e1065"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "//": "apiUrl is the backend a RELEASE build talks to. Development ignores it and auto-detects the dev machine's LAN IP instead (see src/config.ts). Leaving it null makes a release build fail loudly at startup rather than silently calling localhost — set it, or pass EXPO_PUBLIC_API_URL at build time.",
      "apiUrl": null
    }
  }
}
