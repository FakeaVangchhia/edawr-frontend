# ---- Environment ----
# "development" allows the insecure defaults below. Any other value makes the
# app refuse to start unless JWT_SECRET has been replaced.
ENVIRONMENT=development

# ---- Database ----
# SQLite by default (zero setup). Switch to Postgres by changing only this line:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/edawr
DATABASE_URL=sqlite:///./edawr.db

# ---- Auth ----
# Signing key for JWTs. MUST be a long random value in production, and at
# least 32 bytes or PyJWT will warn that it is too weak for HS256.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- CORS ----
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Uploads ----
# Directory (relative to backend/) where product images are written.
UPLOAD_DIR=uploads

# ---- Seed data (used by seed.py only) ----
SEED_ADMIN_EMAIL=admin@edawr.local
SEED_ADMIN_PASSWORD=admin1234
