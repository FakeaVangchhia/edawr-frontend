# Repo-wide ignores. Each package also has its own .gitignore for the things
# only that toolchain produces (backend/.gitignore, frontend/.gitignore,
# mobile/.gitignore) — this file is only for what spans all three.

# Secrets. Every package ships a committed .env.example instead; nothing real
# is ever committed. See docs/deployment.md.
.env
.env.local
.env.*.local
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Scratch space
/tmp/
*.log

# backend/ is its own repository, pushed to github.com/FakeaVangchhia/edawr-backend.
# It is ignored here rather than absorbed so that remote keeps working — commit
# backend changes from inside backend/. If you ever want a single repo, use
# `git subtree add` so the history comes with it; a plain `git add backend` would
# record a gitlink and silently ship an empty directory to anyone who clones.
/backend/
